{
  "name": "collexion-campus",
  "main": "worker/frontend.mjs",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "workers_dev": true,
  "preview_urls": false,
  "services": [
    {
      "binding": "API",
      "service": "campus-orbit-api"
    }
  ]
}
